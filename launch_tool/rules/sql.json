  {
    "id": "SQL-PERCENT-FORMAT-001",
    "description": "SQL query built with %-format string interpolation (SQL injection)",
    "vulnerabilities": "INJC",
    "pattern": "\\.execute\\(\\s*(?:\\\"[^\\\"]*\\\"|'[^']*')\\s*%",
    "pattern_not": [
      "\\.execute\\([^)]*%[^,]+,\\s*\\("
    ],
    "pattern_not_file": [
      "sqlalchemy|sqlmodel|orm"
    ],
    "find_var": "",
    "remediation": [
      {
        "source": "\\.execute\\(\\s*(?P<sql>\\\"[^\\\"]*\\\"|'[^']*')\\s*%\\s*\\((?P<args>[^)]+)\\)\\s*\\)",
        "replacement": ".execute(\\g<sql>, (\\g<args>))",
        "imports": "",
        "comment": "use parameterized query (driver-handled escaping) instead of % interpolation"
      },
      {
        "source": "\\.execute\\(\\s*(?P<sql>\\\"[^\\\"]*\\\"|'[^']*')\\s*%\\s*(?P<var>\\w+)\\s*\\)",
        "replacement": ".execute(\\g<sql>, (\\g<var>,))",
        "imports": "",
        "comment": "use parameterized query (driver-handled escaping) instead of % interpolation"
      }
    ]
  }
]
