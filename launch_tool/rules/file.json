  {
    "id": "OPEN-PATH-CONCAT-001",
    "description": "Path traversal via open with string concatenation",
    "vulnerabilities": "BRAC",
    "pattern": "open\\(\\s*['\\\"][^'\\\"]*/['\\\"]?\\s*\\+\\s*\\w+",
    "pattern_not": [
      "os\\.path\\.isfile\\s*\\(",
      "secure_filename\\s*\\(",
      "\\.startswith\\s*\\(",
      "with[ ]+open\\("
    ],
    "pattern_not_file": [
      "os\\.path\\.isfile\\s*\\(",
      "secure_filename\\s*\\(",
      "['\\\"][/\\\\.][/\\\\.]?['\\\"][ ]*in[ ]*\\w+",
      "_safe_path\\s*=",
      "\\.startswith\\s*\\(",
      "os\\.path\\.realpath\\s*\\("
    ],
    "find_var": "",
    "remediation": [
      {
        "source": "(?P<indent>[ \\t]+)(?P<lhs>return\\s+|\\w+\\s*=\\s*|)open\\((?P<path>['\\\"][^'\\\"]*/['\\\"]?\\s*\\+\\s*\\w+)\\s*,?\\s*(?P<openrest>[^)]*)\\)(?P<chain>\\.[a-z]+\\(\\)|)",
        "replacement": "\\g<indent>_safe_path = \\g<path>\\n\\g<indent>if not os.path.isfile(_safe_path):\\n\\g<indent>    abort(404)\\n\\g<indent>\\g<lhs>open(_safe_path, \\g<openrest>)\\g<chain>",
        "imports": "import os",
        "comment": "added path-existence guard before opening user-controlled file path"
      },
      {
        "source": "(?P<indent>[ \\t]+)return[ ]+open\\((?P<path>['\\\"][^'\\\"]*/['\\\"]?\\s*\\+\\s*\\w+)\\s*,?\\s*(?P<openrest>[^)]*)\\)",
        "replacement": "\\g<indent>_safe_path = \\g<path>\\n\\g<indent>if not os.path.isfile(_safe_path):\\n\\g<indent>    abort(404)\\n\\g<indent>return open(_safe_path, \\g<openrest>)",
        "imports": "import os",
        "comment": "added path-existence guard before opening user-controlled file path"
      },
      {
        "source": "open\\(",
        "replacement": "open(",
        "imports": "",
        "comment": "validate path stays inside an allow-listed directory before open()"
      }
    ]
  },
  {
    "id": "OPEN-REQUEST-DIRECT-001",
    "description": "Path traversal via open() with concatenated request expression",
    "vulnerabilities": "BRAC",
    "pattern": "open\\(\\s*['\\\"][^'\\\"]+['\\\"]\\s*\\+\\s*request\\.\\w+",
    "pattern_not": [
      "os\\.path\\.isfile\\s*\\(",
      "secure_filename\\s*\\("
    ],
    "pattern_not_file": [
      "_safe_path\\s*=",
      "os\\.path\\.isfile\\s*\\(",
      "secure_filename\\s*\\("
    ],
    "find_var": "",
    "remediation": [
      {
        "source": "open\\(\\s*(?P<path>['\\\"][^'\\\"]+['\\\"]\\s*\\+\\s*request\\.[\\w.]+\\([^)]*\\)|['\\\"][^'\\\"]+['\\\"]\\s*\\+\\s*request\\.\\w+\\[['\\\"][^'\\\"]+['\\\"]\\])\\s*,?\\s*(?P<rest>[^)]*)\\)",
        "replacement": "(_safe_path := \\g<path>) and os.path.isfile(_safe_path) and open(_safe_path, \\g<rest>)",
        "imports": "import os",
        "comment": "validate file path is inside an allow-list directory before open()"
      }
    ]
  },
  {
    "id": "OPEN-USER-VAR-001",
    "description": "open() called with user-controlled bare variable",
    "vulnerabilities": "BRAC",
    "pattern": "\\bopen\\(\\s*VAR_PLACEHOLDER\\s*,",
    "pattern_not_file": [
      "os\\.path\\.isfile\\s*\\(",
      "secure_filename\\s*\\(",
      "['\\\"][/\\\\.][/\\\\.]?['\\\"][ ]*in[ ]*\\w+"
    ],
    "find_var": "request\\.(args\\.get|args\\[|form|GET\\.get|POST\\.get|values\\.get)",
    "remediation": [
      {
        "source": "open\\(\\s*VAR_PLACEHOLDER\\s*,\\s*(?P<mode>['\\\"][^'\\\"]*['\\\"])\\s*\\)",
        "replacement": "open(secure_filename(VAR_PLACEHOLDER), \\g<mode>)",
        "imports": "from werkzeug.utils import secure_filename",
        "comment": "wrap user-controlled filename with secure_filename() before open()"
      }
    ]
  }
]
